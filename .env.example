# FinSight Environment Configuration Example
# Copy to .env and provide your values

# Application
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database
# Default to SQLite for local development, or set PostgreSQL URI
DATABASE_URL=sqlite+aiosqlite:///./finsight.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fin_sight

# Gnani AI API Credentials
GNANI_API_KEY=your_gnani_api_key_here
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference

# Optional Reasoning / LLM model (Groq, OpenAI, Gemini, or Gnani Evon)
REASONING_PROVIDER=gnani
REASONING_MODEL=evon-30b
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Security
SECRET_KEY=finsight_dev_secret_key_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Slack Integration & Autonomous Sentinel
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_USER_TOKEN=xoxp-your-user-token
SLACK_CHANNEL_ID=C09M5ETUMPF
SLACK_CHANNEL_NAME=#engineering-inventory-tracker
